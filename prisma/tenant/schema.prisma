// Education Call Center CRM — data model
// See /Users/bstar/.claude/plans/magical-cooking-oasis.md for the reasoning behind
// the queue engine design and the CallResult -> LeadStatus mapping.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/tenant-client"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth (NextAuth / Auth.js Prisma adapter) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Core enums ----------

enum Role {
  SUPER_ADMIN
  MANAGER
  AGENT
}

// Doubles as the lead's queue-lifecycle status (matches the SRS's queue
// status list verbatim: Available / Assigned / Follow-up / Completed /
// Converted / Lost).
enum LeadStatus {
  AVAILABLE
  ASSIGNED
  FOLLOW_UP
  COMPLETED
  CONVERTED
  LOST
}

enum InterestLevel {
  LOW
  MEDIUM
  HIGH
}

enum CallResult {
  INTERESTED
  NEED_FOLLOW_UP
  NO_ANSWER
  BUSY
  WRONG_NUMBER
  NOT_INTERESTED
  APPOINTMENT_BOOKED
  REGISTERED
  CALL_BACK_LATER
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ImportStrategy {
  ADD_NEW_ONLY
  UPDATE_EXISTING
  MERGE
}

enum TimelineEventType {
  LEAD_CREATED
  STATUS_CHANGED
  CALL_LOGGED
  NOTE_ADDED
  FOLLOW_UP_SCHEDULED
  APPOINTMENT_BOOKED
  APPOINTMENT_UPDATED
  ASSIGNED_TO_EMPLOYEE
  RELEASED_TO_QUEUE
  IMPORTED
}

// ---------- Users / Employees ----------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  importLogs   ImportLog[]
  activityLogs ActivityLog[]
}

model Employee {
  id           String    @id @default(cuid())
  name         String
  phone        String?
  isActive     Boolean   @default(true)
  // Heartbeat used by the queue's auto-release check: updated on login and
  // on every queue-relevant API call. A lead assigned to an employee whose
  // lastActiveAt is older than Settings.inactivityTimeoutHours is released
  // back to AVAILABLE.
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  user          User?
  assignedLeads Lead[]        @relation("AssignedEmployee")
  callLogs      CallLog[]
  followUps     FollowUp[]
  appointments  Appointment[]
}

// ---------- Lookup tables ----------

model Branch {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)

  appointments Appointment[]
}

model Source {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)

  leads Lead[]
}

// ---------- Leads ----------

model Lead {
  id       String  @id @default(cuid())
  fullName String
  phone    String  @unique // normalized dedupe key, e.g. "96550000000"
  phoneRaw String? // as originally entered/imported
  email    String?

  // Free text on purpose — the SRS explicitly forbids a dropdown here.
  studyGrade String?
  area       String?

  sourceId           String
  source             Source     @relation(fields: [sourceId], references: [id])
  assignedEmployeeId String?
  assignedEmployee   Employee?  @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id])

  status           LeadStatus     @default(AVAILABLE)
  interestLevel    InterestLevel?
  notes            String?        @db.Text
  lastContactDate  DateTime?
  nextFollowUpDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeline     LeadTimeline[]
  callLogs     CallLog[]
  followUps    FollowUp[]
  appointments Appointment[]

  @@index([status])
  @@index([assignedEmployeeId])
  @@index([nextFollowUpDate])
  @@index([sourceId])
  @@index([createdAt])
}

// Append-only. Every mutating action on a lead writes one row here and
// nothing is ever updated or deleted — this is the concrete implementation
// of the SRS's "Timeline" requirement.
model LeadTimeline {
  id         String            @id @default(cuid())
  leadId     String
  lead       Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       TimelineEventType
  summary    String
  metadata   Json?
  employeeId String?
  createdAt  DateTime          @default(now())

  @@index([leadId, createdAt])
}

model CallLog {
  id              String     @id @default(cuid())
  leadId          String
  lead            Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee   @relation(fields: [employeeId], references: [id])
  result          CallResult
  durationSeconds Int?
  notes           String?    @db.Text
  calledAt        DateTime   @default(now())
  createdAt       DateTime   @default(now())

  @@index([leadId])
  @@index([employeeId, calledAt])
}

model FollowUp {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  followUpDate DateTime
  followUpTime String? // "HH:mm"
  notes        String?  @db.Text
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([leadId])
  @@index([followUpDate])
}

model Appointment {
  id         String            @id @default(cuid())
  leadId     String
  lead       Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  date       DateTime
  time       String // "HH:mm"
  branchId   String?
  branch     Branch?           @relation(fields: [branchId], references: [id])
  employeeId String?
  employee   Employee?         @relation(fields: [employeeId], references: [id])
  notes      String?           @db.Text
  status     AppointmentStatus @default(BOOKED)
  createdAt  DateTime          @default(now())

  @@index([leadId])
  @@index([date])
}

// ---------- Import + activity logs ----------

model ImportLog {
  id             String         @id @default(cuid())
  fileName       String
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  rowCount       Int
  addedCount     Int
  updatedCount   Int            @default(0)
  duplicateCount Int
  errorCount     Int
  strategy       ImportStrategy
  createdAt      DateTime       @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. "LEAD_ASSIGNED", "SETTINGS_UPDATED"
  entityType String // "Lead" | "Appointment" | "Settings" | ...
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ---------- Settings ----------

// Single-row table (id is always "singleton") holding queue-engine config,
// editable by Super Admin.
model Settings {
  id                     String @id @default("singleton")
  queueSize              Int    @default(20)
  inactivityTimeoutHours Int    @default(48)
}
